{
  "compilerOptions": {
    "target": "ES2020",
    "lib": ["ES2020", "DOM"],
    "types": ["cypress"],
    "baseUrl": ".",
    "paths": {
      "@fixtures/*": ["cypress/fixtures/*"],
      "@support/*": ["cypress/support/*"]
    }
  },
  "include": [
    "cypress/**/*.js",
    "cypress.config.js"
  ],
  "exclude": [
    "node_modules"
  ]
}